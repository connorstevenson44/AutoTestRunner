<Window x:Class="OrderDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrderDesk"
        Title="Order Desk" Width="1100" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />

        <DataTemplate x:Key="OrderTemplate" DataType="{x:Type local:OrderRow}">
            <Button x:Name="Row" Style="{StaticResource OrderRow}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource Brand}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource InkMuted}" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#E6F4EA" CornerRadius="8" Padding="8,1" Margin="8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsShipped, Converter={StaticResource Shown}}">
                        <TextBlock Text="Shipped" Foreground="{StaticResource Good}" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Column="3" Text="{Binding Money}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                    <!-- These only show while the mouse is over the row. -->
                    <StackPanel x:Name="Actions" Grid.Column="4" Orientation="Horizontal" Visibility="Hidden" VerticalAlignment="Center">
                        <Button Content="Ship" ToolTip="Mark as shipped" Click="OnShip" Padding="8,2" Margin="4,0,0,0" />
                        <Button Content="Delete" ToolTip="Delete this order" Click="OnDelete" Padding="8,2" Margin="4,0,0,0" Foreground="{StaticResource Danger}" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- The bar at the top -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brand}" Padding="16,10">
            <DockPanel>
                <TextBlock Text="Order Desk" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ImportButton" Style="{StaticResource BarButton}" Content="Import orders…" ToolTip="Add orders from a .csv file"
                            AutomationProperties.Name="Import orders" Click="OnImport" />
                    <Button x:Name="ExportButton" Style="{StaticResource BarButton}" Content="Export orders" ToolTip="Write every order to orders.csv"
                            Click="OnExport" IsEnabled="{Binding IsChecked, ElementName=CheckedBox}" />
                    <Button x:Name="ConnectButton" Style="{StaticResource BarButton}" Content="Connect to warehouse" ToolTip="Send the orders to the warehouse"
                            Click="OnConnect" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The bar at the bottom: what the app is doing -->
        <Border DockPanel.Dock="Bottom" Background="#F1F3F4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- A new order -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NEW ORDER" FontWeight="Bold" Foreground="{StaticResource Brand}" />

                        <TextBlock Text="Customer" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CustomerBox" AutomationProperties.Name="Customer" TextChanged="OnFormChanged" />

                        <TextBlock Text="Product" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProductBox" AutomationProperties.Name="Product" SelectionChanged="OnFormChanged" />
                        <TextBlock x:Name="PriceText" Foreground="{StaticResource InkMuted}" FontSize="12" Margin="0,4,0,0" />

                        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="QuantityBox" AutomationProperties.Name="Quantity" Text="1" TextChanged="OnFormChanged" />

                        <CheckBox x:Name="GiftWrapBox" Content="Gift wrap (+£2.00)" AutomationProperties.Name="Gift wrap" Margin="0,12,0,0"
                                  Checked="OnFormChanged" Unchecked="OnFormChanged" />
                        <CheckBox x:Name="ExpressBox" Content="Express delivery (+£5.00)" AutomationProperties.Name="Express delivery" Margin="0,8,0,0"
                                  Checked="OnFormChanged" Unchecked="OnFormChanged" />

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NotesBox" AutomationProperties.Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock x:Name="ProblemText" Foreground="{StaticResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="TotalText" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="AddButton" Content="Add order" IsDefault="True" Click="OnAdd" IsEnabled="False" />
                            <Button x:Name="ClearButton" Content="Clear" Click="OnClear" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl x:Name="Tabs" Grid.Column="2">
                <TabItem Header="Orders">
                    <DockPanel Margin="4">
                        <CheckBox x:Name="CheckedBox" DockPanel.Dock="Top" Content="I have checked the orders" Margin="6,8,6,8"
                                  ToolTip="Tick this before you export" />
                        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="No orders yet." Foreground="{StaticResource InkMuted}" Margin="6,4" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="OrdersList" ItemTemplate="{StaticResource OrderTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Catalogue">
                    <!-- 500 products in a list that only builds the rows in view, as long lists in real apps do. -->
                    <ListBox x:Name="CatalogueList" AutomationProperties.Name="Catalogue" Margin="4" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CatalogueItem}">
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <TextBlock Text="{Binding Name}" Width="140" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Width="240" Foreground="{StaticResource InkMuted}" />
                                    <TextBlock Text="{Binding Price}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
