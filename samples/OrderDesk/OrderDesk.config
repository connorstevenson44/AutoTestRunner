<?xml version="1.0" encoding="utf-8"?>
<!-- Order Desk's connections. {DataFolder} is the data folder: %LOCALAPPDATA%\OrderDesk, or the folder given with
     data. WarehouseBroker is the shop's own RabbitMQ; a test computer points it at one of its own. -->
<configuration>
  <connectionStrings>
    <add name="Orders" connectionString="Data Source={DataFolder}\orderdesk.db;Pooling=False" />
  </connectionStrings>
  <appSettings>
    <add key="WarehouseBroker" value="amqp://orderdesk:orderdesk@warehouse.contoso.local:5672/" />
    <add key="WarehouseOrdersQueue" value="warehouse.orders" />
    <add key="WarehousePicksQueue" value="orderdesk.picks" />
    <add key="ShopName" value="Contoso Coffee and Tea" />
  </appSettings>
</configuration>
