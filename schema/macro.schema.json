{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "macro.schema.json",
  "title": "AutoTestRunner macro",
  "description": "Reusable steps with parameters, run with { \"call\": name }.",
  "type": "object",
  "required": [
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Its name, if not the file's."
    },
    "description": {
      "type": "string",
      "description": "What it does."
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "$ref": "case.schema.json#/definitions/steps"
    },
    "returns": {
      "type": "string",
      "description": "The variable the call's as keeps."
    }
  },
  "additionalProperties": false
}
