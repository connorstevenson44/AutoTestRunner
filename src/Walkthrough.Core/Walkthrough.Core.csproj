<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The engine targets plain net10.0 so its tests run anywhere. The machine checks (services, scheduled tasks)
         only run on Windows, so the Windows-only API warnings are not useful here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Walkthrough.Core.Tests" />
  </ItemGroup>

</Project>
