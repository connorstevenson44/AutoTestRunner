{
  "$schema": "../../../schema/case.schema.json",
  "name": "OD-IMP-01 Import orders, skipping drafts",
  "needs": ["back-up-and-restore"],
  "covers": "Import orders from a .csv: one window per order, Import or Skip, drafts skipped",
  "tags": ["import"],
  "steps": [
    { "writeFile": "${exportDir}\\to-import.csv", "text": ["customer,product,quantity,note", "Mary Jackson,Green tea,2,", "Dorothy Vaughan,Mug,4,draft"] },
    { "writeFile": "${exportDir}\\to-import.csv", "text": ["Margaret Hamilton,Coffee beans,1,"], "append": true, "say": "A late order, phoned in" },
    { "click": "importOrders" },
    { "pickFile": "Import orders", "path": "${exportDir}\\to-import.csv" },
    { "whileShows": "importWindow", "untilText": "statusText", "matches": "^Import finished", "new": true, "within": 60, "as": "finished",
      "what": "Import",
      "steps": [
        { "find": { "id": "Counter", "within": "importWindow" }, "as": "counter", "within": 10 },
        { "find": { "id": "Summary", "within": "importWindow" }, "as": "summary", "within": 10 },
        { "if": { "contains": "${summary}", "text": "(draft)" },
          "steps": [ { "click": { "button": "Skip", "within": "importWindow" } } ],
          "else": [ { "click": { "button": "Import", "within": "importWindow" } } ] },
        { "note": "The next order's window can show straight away, so this waits for this one's counter to go rather than the window.",
          "waitGone": { "id": "Counter", "name": "${counter}", "within": "importWindow" }, "within": 10 }
      ] },
    { "checkpoint": "2 orders imported, the draft skipped",
      "checks": [
        { "equals": "${finished}", "to": "Import finished: 2 imported, 1 skipped.", "label": "Status after import" },
        { "dbValue": "orders", "sql": "select Customer from Orders where Number = 1009", "equals": "Mary Jackson", "label": "Order 1009, after the deleted 1008" },
        { "dbValue": "orders", "sql": "select Customer from Orders where Number = 1010", "equals": "Margaret Hamilton" },
        { "dbValue": "orders", "sql": "select Number from Orders where Customer = 'Dorothy Vaughan' and Product = 'Mug'", "rows": 0, "label": "Draft not imported" },
        { "logged": "${activityLog}", "text": "Imported 2, skipped 1" }
      ],
      "look": [ "Orders 1009 Mary Jackson and 1010 Margaret Hamilton at the end of the list." ],
      "tools": [ { "openFile": "${exportDir}\\to-import.csv", "label": "Imported file" } ] }
  ]
}
