<Window x:Class="OrderDesk.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import order" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
    <StackPanel Margin="20">
        <TextBlock x:Name="Counter" FontWeight="SemiBold" Foreground="{StaticResource Brand}" />
        <TextBlock x:Name="Summary" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock Text="Add this order?" Foreground="{StaticResource InkMuted}" Margin="0,8,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ImportButton" Content="Import" IsDefault="True" Click="OnImport" />
            <Button x:Name="SkipButton" Content="Skip" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
