<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A console exe, so CI reads what it prints as it runs. A watched run shows the WPF panel beside the app. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>walk</AssemblyName>
    <RootNamespace>Walkthrough.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Walkthrough.Core\Walkthrough.Core.csproj" />
    <ProjectReference Include="..\Walkthrough.FlaUI\Walkthrough.FlaUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\schema\*.json" LinkBase="schema" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
