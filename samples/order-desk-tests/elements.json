{
  "$schema": "../../schema/elements.schema.json",
  "userName": { "id": "UserBox" },
  "password": { "id": "PasswordBox" },
  "signIn": { "id": "SignInButton" },
  "signInProblem": { "id": "SignInProblem" },

  "statusText": { "id": "StatusText" },
  "signedInAs": { "id": "SignedInText" },
  "customer": [ { "id": "CustomerBox" }, { "type": "Edit", "name": "Customer" } ],
  "product": { "id": "ProductBox" },
  "price": { "id": "PriceText" },
  "quantity": { "id": "QuantityBox" },
  "giftWrap": { "type": "CheckBox", "name": "Gift wrap" },
  "delivery": { "radioButton": "${option}" },
  "deliverBy": { "id": "DeliverByBox" },
  "notes": { "id": "NotesBox" },
  "formProblem": { "id": "ProblemText" },
  "formTotal": { "id": "TotalText" },
  "addOrder": { "button": "Add order" },

  "orderRow": { "type": "Button", "helpText": "Order ${number}" },
  "orderRowButton": { "type": "Button", "helpText": "${tip}", "within": { "element": "orderRow", "with": { "number": "${number}" } } },
  "orderLabel": { "type": "Text", "helpText": "Order ${number} ${status}" },
  "checkedTheOrders": { "type": "CheckBox", "name": "I have checked the orders" },
  "exportOrders": { "id": "ExportButton" },
  "importOrders": { "id": "ImportButton" },
  "importWindow": { "window": "Import order" },

  "orderWindow": { "window": "Order ${number}" },
  "orderQuantity": { "id": "DetailQuantityBox", "within": { "element": "orderWindow", "with": { "number": "${number}" } } },
  "orderNote": { "id": "DetailNotesBox", "within": { "element": "orderWindow", "with": { "number": "${number}" } } },
  "orderTotal": { "id": "DetailTotal", "within": { "element": "orderWindow", "with": { "number": "${number}" } } },
  "saveOrder": { "id": "SaveButton", "within": { "element": "orderWindow", "with": { "number": "${number}" } } },

  "customersGrid": { "id": "CustomersGrid" },
  "customerCell": { "cell": { "row": "${account}", "column": "${column}" }, "within": "customersGrid" },

  "categories": { "id": "CategoryTree" },
  "catalogueProduct": { "listItem": "${name}", "scrollToFind": true },

  "activityList": { "id": "ActivityList" },
  "activityPage": { "id": "PageText" },
  "olderActivity": { "button": "Older" },
  "newerActivity": { "button": "Newer" },

  "aboutWindow": { "window": "About Order Desk" },
  "aboutVersion": { "id": "VersionText", "within": "aboutWindow" },
  "releaseNotes": { "hyperlink": "Release notes", "within": "aboutWindow" },
  "closeAbout": { "button": "OK", "within": "aboutWindow" }
}
