<Window x:Class="OrderDesk.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Order Desk" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
    <StackPanel Margin="24">
        <TextBlock Text="Order Desk" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Brand}" />
        <TextBlock x:Name="VersionText" Margin="0,4,0,0" />
        <TextBlock x:Name="ShopText" Foreground="{StaticResource InkMuted}" Margin="0,2,0,12" />
        <TextBlock>
            <Hyperlink x:Name="NotesLink" NavigateUri="https://github.com/connorstevenson44/AutoTestRunner/blob/main/samples/OrderDesk/CHANGES.md"
                       RequestNavigate="OnNotes">Release notes</Hyperlink>
        </TextBlock>
        <Button x:Name="OkButton" Content="OK" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnOk" />
    </StackPanel>
</Window>
