{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "walkthrough.suite.schema.json",
  "title": "Walkthrough suite",
  "description": "How to start and reset an app, and the suite's variables.",
  "type": "object",
  "required": [
    "name",
    "app"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "The suite's name."
    },
    "app": {
      "type": "object",
      "required": [
        "exe",
        "window"
      ],
      "properties": {
        "exe": {
          "type": "string",
          "description": "The program to start; ${variables} allowed."
        },
        "arguments": {
          "type": "string",
          "description": "What to start it with."
        },
        "window": {
          "type": "string",
          "description": "Its main window's title."
        },
        "runAsAdmin": {
          "type": "boolean",
          "description": "Restarts walk as administrator, as the app needs it."
        },
        "status": {
          "type": "string",
          "description": "An element whose text says what the app is doing, such as a status bar. Its text before each click is kept for waitText's new."
        }
      },
      "additionalProperties": false
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "object",
            "required": [
              "firstExisting"
            ],
            "properties": {
              "firstExisting": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The first path that exists, relative to the suite folder; the last when none does."
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "helpers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "regex"
        ],
        "properties": {
          "regex": {
            "type": "string",
            "description": "${name(value)} gives the regex's first group in value."
          }
        },
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths that must exist before a run starts. If one doesn't, walk exits with code 2."
    },
    "reset": {
      "type": "object",
      "properties": {
        "powershell": {
          "type": "string",
          "description": "A script that removes what the suite leaves on the machine."
        },
        "leftovers": {
          "type": "string",
          "description": "A script that prints one line for each thing an earlier run left; nothing on a clean machine."
        }
      },
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      },
      "description": "The smallest screen the suite is written for."
    }
  },
  "additionalProperties": false
}
