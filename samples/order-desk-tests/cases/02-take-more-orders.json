{
  "$schema": "../../../schema/case.schema.json",
  "name": "Take orders for three customers",
  "needs": ["take-an-order"],
  "covers": "Order numbers go up by one, and each order's product, quantity, gift wrap and total are saved",
  "tags": ["orders"],
  "steps": [
    { "repeat": { "rows": "data/new-orders.csv" }, "item": "order",
      "steps": [
        { "call": "addOrder", "with": { "customer": "${order.Customer}", "product": "${order.Product}", "quantity": "${order.Quantity}", "giftWrap": "${order.GiftWrap}" },
          "as": "status" }
      ] },
    { "checkpoint": "Orders 1002 to 1004 are saved",
      "checks": [
        { "jsonValue": "${ordersFile}", "path": "orders:1002:product", "equals": "Green tea" },
        { "jsonValue": "${ordersFile}", "path": "orders:1002:quantity", "equals": "3" },
        { "jsonValue": "${ordersFile}", "path": "orders:1003:giftWrap", "equals": "true" },
        { "jsonValue": "${ordersFile}", "path": "orders:1003:total", "equals": "8.00" },
        { "jsonValue": "${ordersFile}", "path": "orders:1004:product", "equals": "Teapot" },
        { "equals": "${status}", "to": "Added order 1004 for Katherine Johnson: £24.00.", "label": "Last status" },
        { "fileContains": "${activityLog}", "text": "Added order 1004: Katherine Johnson" },
        { "shows": { "element": "orderRow", "with": { "number": "1002" } } },
        { "shows": { "element": "orderRow", "with": { "number": "1003" } } },
        { "shows": { "element": "orderRow", "with": { "number": "1004" } } }
      ],
      "look": [ "The list shows 1001 to 1004, oldest first." ],
      "tools": [ { "openFile": "${ordersFile}", "label": "orders.json" } ] }
  ]
}
