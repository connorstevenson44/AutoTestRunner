<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A console exe, so CI reads what it prints as it runs. A watched run shows the WPF panel beside the app. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>autotest</AssemblyName>
    <RootNamespace>AutoTestRunner.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoTestRunner.Core\AutoTestRunner.Core.csproj" />
    <ProjectReference Include="..\AutoTestRunner.FlaUI\AutoTestRunner.FlaUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\schema\*.json" LinkBase="schema" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
