<Window x:Class="OrderDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrderDesk"
        Title="Order Desk" Width="1100" Height="740" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="White" PreviewKeyDown="OnKey"
        PreviewMouseMove="OnDragMove" PreviewMouseLeftButtonUp="OnDragDrop">
    <Window.Resources>
        <DataTemplate x:Key="OrderTemplate" DataType="{x:Type local:OrderRow}">
            <Button x:Name="Row" Style="{StaticResource OrderRow}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Title}"
                    MouseDoubleClick="OnOpenOrder">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open order…" AutomationProperties.Name="Open order" Click="OnOpenOrder" />
                        <MenuItem Header="Duplicate order" Click="OnDuplicate" />
                        <MenuItem Header="Copy order number" Click="OnCopyNumber" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource Brand}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource InkMuted}" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{Binding LabelBack}" CornerRadius="8" Padding="8,1" Margin="8,0" VerticalAlignment="Center"
                            Visibility="{Binding LabelShown}">
                        <TextBlock Text="{Binding Label}" Foreground="{Binding LabelInk}" FontSize="12" AutomationProperties.HelpText="{Binding LabelTip}" />
                    </Border>
                    <TextBlock Grid.Column="3" Text="{Binding Money}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                    <!-- These only show while the mouse is over the row. -->
                    <StackPanel x:Name="Actions" Grid.Column="4" Orientation="Horizontal" Visibility="Hidden" VerticalAlignment="Center">
                        <Button Content="Ship" ToolTip="Mark as shipped" Click="OnShip" Padding="8,2" Margin="4,0,0,0" />
                        <Button Content="Delete" ToolTip="Delete this order" Click="OnDelete" Padding="8,2" Margin="4,0,0,0" Foreground="{StaticResource Danger}" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_File">
                <MenuItem x:Name="ExportToMenu" Header="Export to folder…" AutomationProperties.Name="Export to folder" Click="OnExportTo"
                          IsEnabled="{Binding IsChecked, ElementName=CheckedBox}" />
                <MenuItem Header="Back up…" AutomationProperties.Name="Back up" Click="OnBackUp" />
                <MenuItem Header="Restore…" AutomationProperties.Name="Restore" Click="OnRestore" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Schedule nightly export" Click="OnSchedule" />
                <MenuItem Header="Stop nightly export" Click="OnUnschedule" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About Order Desk" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- The bar at the top -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brand}" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Order Desk" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SignedInText" Foreground="#CCFFFFFF" Margin="12,0,0,0" VerticalAlignment="Bottom" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ImportButton" Style="{StaticResource BarButton}" Content="Import orders…" ToolTip="Add orders from a .csv file"
                            AutomationProperties.Name="Import orders" Click="OnImport" />
                    <Button x:Name="ExportButton" Style="{StaticResource BarButton}" Content="Export orders" ToolTip="Write every order to orders.csv"
                            Click="OnExport" IsEnabled="{Binding IsChecked, ElementName=CheckedBox}" />
                    <Button x:Name="ConnectButton" Style="{StaticResource BarButton}" Content="Connect to warehouse" ToolTip="Send shipped orders to the warehouse"
                            Click="OnConnect" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The bar at the bottom: what the app is doing -->
        <Border DockPanel.Dock="Bottom" Background="#F1F3F4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- A new order -->
            <Border x:Name="OrderForm" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NEW ORDER" FontWeight="Bold" Foreground="{StaticResource Brand}" />

                        <TextBlock Text="Customer" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CustomerBox" AutomationProperties.Name="Customer" TextChanged="OnFormChanged" />

                        <TextBlock Text="Product" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProductBox" AutomationProperties.Name="Product" SelectionChanged="OnFormChanged" />
                        <TextBlock x:Name="PriceText" Foreground="{StaticResource InkMuted}" FontSize="12" Margin="0,4,0,0" />

                        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="QuantityBox" AutomationProperties.Name="Quantity" Text="1" TextChanged="OnFormChanged" />

                        <CheckBox x:Name="GiftWrapBox" AutomationProperties.Name="Gift wrap" Margin="0,12,0,0"
                                  Checked="OnFormChanged" Unchecked="OnFormChanged" />

                        <TextBlock Text="Delivery" Style="{StaticResource FieldLabel}" />
                        <StackPanel x:Name="DeliveryChoice" AutomationProperties.Name="Delivery">
                            <RadioButton x:Name="StandardBox" GroupName="Delivery" AutomationProperties.Name="Standard" IsChecked="True"
                                         Checked="OnFormChanged" Content="Standard (free)" />
                            <RadioButton x:Name="ExpressBox" GroupName="Delivery" AutomationProperties.Name="Express" Margin="0,4,0,0"
                                         Checked="OnFormChanged" />
                            <RadioButton x:Name="NextDayBox" GroupName="Delivery" AutomationProperties.Name="Next day" Margin="0,4,0,0"
                                         Checked="OnFormChanged" />
                        </StackPanel>

                        <TextBlock Text="Deliver by" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="DeliverByBox" AutomationProperties.Name="Deliver by" SelectedDateChanged="OnFormChanged" />

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NotesBox" AutomationProperties.Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="54"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock x:Name="ProblemText" Foreground="{StaticResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="TotalText" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="AddButton" Content="Add order" IsDefault="True" Click="OnAdd" IsEnabled="False" />
                            <Button x:Name="ClearButton" Content="Clear" Click="OnClear" ToolTip="Clear the form (Ctrl+N)" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl x:Name="Tabs" Grid.Column="2" SelectionChanged="OnTabChanged">
                <TabItem Header="Orders">
                    <DockPanel Margin="4">
                        <CheckBox x:Name="CheckedBox" DockPanel.Dock="Top" Content="I have checked the orders" Margin="6,8,6,8"
                                  ToolTip="Tick this before you export" />
                        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="No orders yet." Foreground="{StaticResource InkMuted}" Margin="6,4" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="OrdersList" AutomationProperties.Name="Orders" ItemTemplate="{StaticResource OrderTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Customers">
                    <DataGrid x:Name="CustomersGrid" AutomationProperties.Name="Customers" Margin="4" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              HorizontalGridLinesBrush="{StaticResource Line}" Background="White" RowBackground="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="90" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                            <DataGridTextColumn Header="Orders" Binding="{Binding Orders}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Catalogue">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TreeView x:Name="CategoryTree" AutomationProperties.Name="Categories" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Line}"
                                  SelectedItemChanged="OnCategory" />
                        <DockPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Drag a product onto the order form to order it." Foreground="{StaticResource InkMuted}"
                                       FontSize="12" Margin="4,0,0,6" />
                            <!-- A parts list longer than the window, which only builds the rows in view, as long lists in real apps do. -->
                            <ListBox x:Name="CatalogueList" AutomationProperties.Name="Products" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                                     PreviewMouseLeftButtonDown="OnDragStart">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Product}">
                                        <StackPanel Orientation="Horizontal" Margin="4,3">
                                            <TextBlock Text="{Binding Name}" Width="240" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Sku}" Width="80" Foreground="{StaticResource InkMuted}" />
                                            <TextBlock Text="{Binding Price, StringFormat='£0.00'}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Activity">
                    <DockPanel Margin="4">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="NewerButton" DockPanel.Dock="Right" Content="Newer" Margin="0" Click="OnNewer" />
                            <Button x:Name="OlderButton" DockPanel.Dock="Right" Content="Older" Click="OnOlder" />
                            <TextBlock x:Name="PageText" VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" />
                        </DockPanel>
                        <ListBox x:Name="ActivityList" AutomationProperties.Name="Activity" BorderThickness="0" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
