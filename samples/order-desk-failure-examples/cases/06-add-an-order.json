{
  "$schema": "../../../schema/case.schema.json",
  "name": "Add an order",
  "needsNote": "Nothing",
  "covers": "Adding a teapot order. Gets stuck: the test clicks Submit order, which is now called Add order.",
  "tags": ["orders"],
  "steps": [
    { "call": "startWithNoOrders" },
    { "type": "customer", "text": "Katherine Johnson" },
    { "choose": "product", "option": "Teapot" },
    { "click": { "button": "Submit order" }, "within": 5 },
    { "checkpoint": "Order 1001 is added",
      "checks": [ { "dbValue": "orders", "sql": "select Customer from Orders where Number = 1001", "equals": "Katherine Johnson" } ] }
  ]
}
