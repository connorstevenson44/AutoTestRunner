{
  "$schema": "../../schema/suite.schema.json",
  "name": "Order Desk failure examples",
  "app": { "exe": "${exe}", "window": "Order Desk", "startWindow": "Sign in to Order Desk", "status": "statusText" },
  "variables": {
    "exe": { "firstExisting": [
      "../OrderDesk/OrderDesk.exe",
      "../OrderDesk/bin/Release/net10.0-windows/OrderDesk.exe",
      "../OrderDesk/bin/Debug/net10.0-windows/OrderDesk.exe"
    ] },
    "dataDir": "${env:LOCALAPPDATA}\\OrderDesk",
    "database": "${dataDir}\\orderdesk.db",
    "activityLog": "${dataDir}\\activity.log",
    "user": "clerk",
    "password": "clerk-demo"
  },
  "helpers": {
    "amount": { "regex": "£(\\d+\\.\\d\\d)" },
    "exportedFile": { "regex": "File: (.+)$" }
  },
  "databases": {
    "orders": { "kind": "sqlite", "connection": "Data Source=${database};Mode=ReadWrite;Pooling=False" }
  },
  "requires": ["${exe}"],
  "reset": { "script": "tools/Reset-OrderDesk.ps1", "leftovers": "tools/Find-Leftovers.ps1" }
}
