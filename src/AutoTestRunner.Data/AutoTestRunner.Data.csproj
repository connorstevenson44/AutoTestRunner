<Project Sdk="Microsoft.NET.Sdk">

  <!-- The databases and message queues steps and checks use, each through its vendor's own .NET driver. Plain
       net10.0, so its tests run on Linux against the servers in containers; MSMQ goes through Windows PowerShell. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoTestRunner.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoTestRunner.Core\AutoTestRunner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IBMMQDotnetClient" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
